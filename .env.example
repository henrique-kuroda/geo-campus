# Copie para .env e preencha com os dados do projeto no Supabase (Project Settings → API Keys).
# Estes dois vão para dentro do app: a chave publishable é pública e, com o RLS, só permite ler.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# A chave secret NUNCA vai para o app nem para o Git: coloque-a em .env.local (já ignorado pelo Git).
# Só o script npm run sync-supabase usa ela, para gravar locais e fotos.
# SUPABASE_SECRET_KEY=sb_secret_...
